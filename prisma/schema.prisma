generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
  
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Usuarios {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  nome         String
  email        String @unique
  senha        String
  createdAt    DateTime @default(now())
}